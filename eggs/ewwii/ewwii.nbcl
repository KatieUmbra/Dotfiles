import "globals.nbcl" as globals

component BarElement(alignment) {
    Box {
        spacing = 10
        space_evenly = false
        halign = alignment
        self.children
    }
}

Window "bar" {
    monitor = 0
    geometry = {
        x = "0%"
        y = "1%"
        width = "99%"
        height = "5%"
        anchor = "top center"
    }
    stacking = "fg"
    exclusive = true
    focusable = "none"
    namespace = "bar"
    force_normal = false
    # Children
    Box {
        space_evenly = true
        orientation = "horizontal"
        class = "bar"
        BarElement {
            alignment = "start"
            Label { text = "faggot" }
        }
        BarElement {
            alignment = "center"
            Label { text = "dyke" }
        }
        BarElement {
            alignment = "end"
            Label { text = "tranny" }
        }
    }
}
